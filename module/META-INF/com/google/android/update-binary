#!/sbin/sh

#################
# 初始化
#################

umask 022

# 在加载工具函数前定义输出函数。
ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*******************************"
  ui_print " 请安装 Magisk v20.4 或更高版本！ "
  ui_print "*******************************"
  exit 1
}

#########################
# 加载 Magisk 工具函数
#########################

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk

install_module
exit 0
